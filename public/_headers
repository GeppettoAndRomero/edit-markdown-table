## セキュリティヘッダー設定
## Cloudflare Pages用

/*
  # セキュリティヘッダー
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

  # Content Security Policy
  # 静的ホスティング + インラインスタイル + Blob ダウンロード。外部送信はしない（connect-src 'self'）。
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-WN0hqek1jEauhlhWVVXeQPa5BD3f0rsMdmwSZtw1Cys=' 'sha256-qG3no4Z+5U6vm1qGwYBoa+D6/cu/Sl8b+arAUddk78Q=' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob:; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# ハッシュ付きバンドルだけ immutable にする。
# 注意: Cloudflare の _headers は同一ヘッダ名を「結合」するため、immutable を /* に
# 置くと HTML/SW/manifest にも乗り、再デプロイが返訪者・SW precache に伝播しなくなる。
# 必ず content-hash 済みの /edit-markdown-table/_assets/ だけに限定する。
/edit-markdown-table/_assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service Worker: 常に revalidate（更新を確実に伝播させる）
/edit-markdown-table/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /edit-markdown-table/

# Manifest: 短期キャッシュ
/edit-markdown-table/manifest.json
  Cache-Control: public, max-age=3600

# Post-cutover: the router strips this on runlocally.app, so only the *.pages.dev
# origin is noindexed (apex is the sole indexable surface).
/edit-markdown-table/*
  X-Robots-Tag: noindex
